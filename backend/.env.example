# Server configuration
PORT=3000
NODE_ENV=development

# Set to true to serve HTTPS using backend/certs/server.crt and
# backend/certs/server.key. M1 requires the app to reach the backend over
# HTTPS; leave unset for local HTTP development.
ENABLE_HTTPS=

# Database
MONGODB_URI=mongodb://localhost:27017/cpen321
MONGODB_DB=matchmarket

# Google Auth — REQUIRED. The Web OAuth client ID that ID tokens must be issued
# to; the server refuses to start without it. Must be the same value as
# GOOGLE_CLIENT_ID in frontend/local.properties, or every sign-in is rejected.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Session tokens — REQUIRED, at least 32 characters. Signs the tokens the
# backend issues after Google sign-in. A real secret: generate one per server
# with `openssl rand -base64 48` and never commit it. The placeholder below is
# too short on purpose, so the server refuses to start until it is replaced.
JWT_SECRET=replace_me

# OpenRouteService — optional. The API key for travel times on the first page of
# recommendations (free at https://account.heigit.org/signup). Without it,
# the feed is returned without travel times.
ORS_API_KEY=

# Other API keys, secrets, and configurations