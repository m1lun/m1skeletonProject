# Server configuration
PORT=3000
NODE_ENV=development

# Set to true to serve HTTPS using backend/certs/server.crt and
# backend/certs/server.key. M1 requires the app to reach the backend over
# HTTPS; leave unset for local HTTP development.
ENABLE_HTTPS=

# Database
MONGODB_URI=mongodb://localhost:27017/cpen321
MONGODB_DB=matchmarket

# Google Auth — REQUIRED. The Web OAuth client ID that ID tokens must be issued
# to; the server refuses to start without it. Must be the same value as
# GOOGLE_CLIENT_ID in frontend/local.properties, or every sign-in is rejected.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# JWT 
JWT_SECRET=your_jwt_secret_key_here

# Other API keys, secrets, and configurations