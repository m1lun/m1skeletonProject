<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 12 and higher. See
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- The signed-in session, including the refresh token, stays on this
         device (see auth/SessionStore.kt). -->
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_session.xml" />
    </device-transfer>
</data-extraction-rules>
