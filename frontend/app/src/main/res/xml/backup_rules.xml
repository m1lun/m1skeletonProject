<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower. See
   https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- The signed-in session, including the refresh token, stays on this
         device (see auth/SessionStore.kt). -->
    <exclude domain="sharedpref" path="auth_session.xml" />
</full-backup-content>
